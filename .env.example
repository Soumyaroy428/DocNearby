# Database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/docnearby?retryWrites=true&w=majority

# Application & Auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_a_secure_32_character_random_string

# Optional AI Provider (e.g. Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Maps Platform & Google Places Discovery (Optional)
# Server-side key for Google Places API healthcare facility queries:
GOOGLE_MAPS_API_KEY=your_server_google_maps_api_key_here

# Browser client key for interactive Google Maps JavaScript rendering:
NEXT_GOOGLE_MAPS_API_KEY=your_client_google_maps_key_here

# App Environment
NODE_ENV=development

